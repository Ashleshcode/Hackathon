{
  "manifest_version": 3,
  "name": "Veritas AI",
  "version": "0.1.0",
  "description": "Opens Veritas investigations. After an explicit click it can record about 8 seconds of the visible tab, without audio, and send that recording to the local Veritas API.",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Veritas AI",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["activeTab", "storage", "tabCapture", "offscreen"],
  "host_permissions": ["http://localhost:8000/*"]
}
