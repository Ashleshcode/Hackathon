# Backend environment only.
# Copy this file to .env and fill in the values on the machine that runs FastAPI.
# Never commit .env.
# Never place these values in extension/, frontend/, manifest.json, or client-side code.
#
# X_BEARER_TOKEN is the official X API v2 bearer token.
# It is read only by the backend. The API starts without it; campaign X sync then
# reports that the connector is not configured.
# Recent search covers the preceding seven days and spends X API credits per request.
# One sync is capped at X_SYNC_MAX_PAGES pages and X_SYNC_MAX_POSTS posts.
# Leave the token empty until a backend operator is ready to call X.

X_BEARER_TOKEN=
YOUTUBE_API_KEY=
X_SYNC_MAX_PAGES=5
X_SYNC_MAX_POSTS=100
X_SYNC_PAGE_SIZE=10
